{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notion File",
  "version": "0.2.0",
  "identifier": "com.weepwood.notionfile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Notion File",
      "width": 1180,
      "height": 800,
      "minWidth": 960,
      "minHeight": 680,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "将本地文件夹同步到 Notion",
    "longDescription": "使用 Tauri 2、React 与 Rust 构建的本地文件夹到 Notion 单向同步工具。",
    "windows": {
      "wix": null,
      "nsis": { "installMode": "currentUser" }
    }
  }
}
