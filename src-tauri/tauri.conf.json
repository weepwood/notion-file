{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notion File",
  "version": "0.5.0",
  "identifier": "com.weepwood.notionfile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Notion File Drive",
      "width": 1280,
      "height": 820,
      "minWidth": 1040,
      "minHeight": 700,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "以 Notion 为存储层的个人云盘管理器",
    "longDescription": "支持远端文件索引、虚拟目录、分片上传、文件下载、SHA-256 校验、传输记录以及原有文件夹同步。",
    "windows": {
      "wix": null,
      "nsis": { "installMode": "currentUser" }
    }
  }
}
