{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notion Backup",
  "version": "0.2.0",
  "identifier": "com.weepwood.notionfile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Notion Backup",
      "width": 1280,
      "height": 840,
      "minWidth": 1000,
      "minHeight": 700,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "将本地文件增量备份到 Notion",
    "longDescription": "基于 Tauri 2、React 与 Rust 的本地文件到 Notion 增量备份工具，支持历史版本、分片上传和恢复。",
    "windows": {
      "wix": null,
      "nsis": { "installMode": "currentUser" }
    }
  }
}
